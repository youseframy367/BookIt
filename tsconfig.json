{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/components/Dashbord/removeMoerators.tx", "app/(dashboard)/AccessAndRoles/page.jsx", "app/hooks/usePagnation.js", "app/SidebarWrapper.js", "app/(dashboard)/ReservationsRequestsTwo/OrderDetails/page.jsx", "app/(dashboard)/ReservationsRequestsTwo/checkApproved.jsx"  ],
  "exclude": ["node_modules"]
}